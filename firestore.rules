rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Colección de manuales compartidos para que todos los usuarios puedan acceder y colaborar
    match /manuals/{manualId} {
      allow read, write: if true;
    }

    // Colección de proyectos de manuales compartidos
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Colección de prueba para verificación de conectividad
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
